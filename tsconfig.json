{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@routes/*": ["./src/routes/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@prompts/*": ["./src/prompts/*"],
      "@services/*": ["./src/services/*"],
      "@clients/*": ["./src/clients/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src"]
}
